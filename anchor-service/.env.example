# Copy this file to ".env" and fill it in.  NEVER commit ".env" to GitHub.

# true  = pretend to use the blockchain (no wallet needed) - good for first tests
# false = really write to Avalanche
DRY_RUN=true

PORT=8080

# A long random secret. Your APEX app sends it in the "x-api-key" header.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# ---- Blockchain (only needed when DRY_RUN=false) ----
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
EXPLORER_BASE=https://testnet.snowtrace.io

# From deployment.fuji.json after you deploy the contract
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The ISSUER wallet's private key. Use a dedicated wallet that holds ONLY test AVAX.
# Production: keep this in OCI Vault / a secrets manager, not in a file.
ISSUER_PRIVATE_KEY=

# ---- Where the public verify page lives (goes inside the QR code) ----
VERIFY_BASE_URL=http://localhost:5500/index.html

# ---- Words printed on the certificate ----
INSTITUTION_NAME=Murang'a University of Technology
