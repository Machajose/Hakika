# Copy to ".env" in the project root. NEVER commit ".env" to GitHub.
# Used by Hardhat (deploying the contract). The anchor service has its own .env in anchor-service/.

# Private key of a DEDICATED wallet that holds ONLY free Fuji test AVAX. Starts with 0x.
DEPLOYER_PRIVATE_KEY=

# Optional: override the public testnet connection
# FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Only for scripts/add-issuer.js
# REGISTRY_ADDRESS=0x...
# NEW_ISSUER=0x...
# REVOKE_ISSUER=false
